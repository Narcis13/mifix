# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/mifix

# Individual connection settings (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mifix

# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=dev-secret-change-in-production

# CORS - client origin (use * for dev, specific URL for production)
CORS_ORIGIN=*

# Cookies - set to true only with HTTPS
COOKIE_SECURE=false
