PROC ver_cpl
 CLOS ALL
 USE TRANZACT
 COUN ALL FOR unit_mas=6 .AND. ( .NOT. (cantit=0.00 .OR. cantit=1.00)) TO nr
 IF nr<>0
      BROW FOR unit_mas=6 .AND. ( .NOT. (cantit=0.00 .OR. cantit=1.00)) FIELDS c_operat, crt, cod_den, sect, seria NOAPPEND NOEDIT NODELETE TITLE 'COMPLET CU CANTITATEA ERONATA'
 ENDI
 COUN ALL FOR unit_mas=6 .AND. LEN(ALLTRIM(seria))=0 TO nr
 IF nr<>0
      BROW FOR unit_mas=6 .AND. LEN(ALLTRIM(seria))=0 FIELDS c_operat, crt, cod_den, sect, seria NOAPPEND NOEDIT NODELETE TITLE 'COMPLET FARA DENUMIRE'
 ENDI
*
PROC ver_sold
 CLOS ALL
 USE SOLDURI
 COUN ALL FOR cantit<0.00 TO nr
 IF nr<>0
      BROW FOR cantit<0 FIELDS cod_den, cantit NOAPPEND NOEDIT NODELETE TITLE 'SOLDURI NEGATIVE'
 ENDI
