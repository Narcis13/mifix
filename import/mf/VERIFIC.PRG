*
PROC mat_oper
 CLEA
 @ 5, 5 SAY 'VERIFIC INTEGRITATEA OPERATIUNILOR ' COLOR GR+/B,R/W 
 CLOS ALL
 USE TRANZACT
 SET ORDER TO PUN_OP ASCENDING
 SELE 2
 USE OPERATII
 SET ORDER TO ORD_ACT
 SELE 1
 SET RELATION TO STR(tranzact.c_operat, 10) INTO operatii ADDITIVE
 COUN ALL FOR EOF(2) TO nr
 IF nr<>0
      BROW FOR EOF(2) FIELDS c_operat, crt NOAPPEND NOEDIT NODELETE TITLE 'OPERATIUNI IN TRANZACT.DBF FARA CORESPONDENT IN OPERATII.DBF'
 ENDI
 CLOS ALL
 USE TRANZACT
 SELE DISTINCT tranzact.c_operat, tranzact.crt, COUNT(*) FROM TRANZACT GROUP BY tranzact.c_operat, tranzact.crt ORDER BY tranzact.c_operat, tranzact.crt INTO CURSOR QUERY
 SELE query
 COUN ALL FOR cnt<>1 TO nr
 IF nr<>0
      BROW FOR cnt<>1 TITLE 'OPERATIUNI DUBLATE IN BAZA DE DATE TRANZACT.DBF'
 ENDI
 CLOS ALL
 USE OPERATII
 SELE DISTINCT operatii.nr_oper, YEAR(operatii.c_data), COUNT(*) FROM OPERATII GROUP BY operatii.nr_oper, 2 ORDER BY operatii.nr_oper, 2 INTO CURSOR QUERY
 SELE query
 COUN ALL FOR cnt<>1 TO nr
 IF nr<>0
      SELE query
      SET FILTER TO cnt<>1
      GOTO TOP
      SET DELETED OFF
      DO WHILE  .NOT. EOF()
           SELE operatii
           DELE ALL FOR nr_oper=query.nr_oper .AND. YEAR(c_data)=query.exp_2
           GOTO TOP
           LOCA FOR nr_oper=query.nr_oper .AND. YEAR(c_data)=query.exp_2
           RECA
           SELE query
           SKIP 1
      ENDD
      SELE operatii
      PACK
 ENDI
 CLOS ALL
 SELE 1
 USE operatii
 SELE 2
 USE tranzact
 SET ORDER TO pun_op
 SELE 1
 SET RELATION TO STR(YEAR(c_data)*1000000+nr_oper, 10) INTO tranzact ADDITIVE
 DELE ALL FOR EOF(2)
 PACK
 CLOS ALL
*
