 SET TALK OFF
 SET ECHO OFF
 CLOS ALL
 CLEA
 = mat_gest()
 = mat_loc()
 = mat_stoc()
 = mat_cont()
 = mat_fin()
 = mat_pro()
 = mat_um()
 = mat_stare()
 = mat_docume()
 = ver_cpl()
 = ver_sold()
 = ver_data()
 = mat_oper()
 CLEA
 CLOS ALL
*
PROC mat_gest
 CLEA
 @ 5, 5 SAY 'VERIFIC GESTIUNILE CORESPONDENTE ' COLOR GR+/B,R/W 
 CLOS ALL
 USE TRANZACT
 SET ORDER TO PUN_OP
 SELE 2
 USE GESTIUNI
 SET ORDER TO COD
 SELE 1
 SET RELATION TO cod_ges INTO gestiuni ADDITIVE
 COUN ALL FOR EOF(2) TO nr
 IF nr<>0
      BROW FOR EOF(2) FIELDS c_operat, crt, cod_den, cod_ges NOAPPEND NOEDIT NODELETE TITLE 'MATERIALE FARA GESTIUNE'
 ENDI
