 PRIV M.currarea, M.talkstat, M.compstat
 IF SET('TALK')='ON'
      SET TALK OFF
      M.talkstat = 'ON'
 ELSE
      M.talkstat = 'OFF'
 ENDI
 M.compstat = SET('COMPATIBLE')
 SET COMPATIBLE TO FOXPLUS
 IF  .NOT. WEXIST('avertiz') .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.PJX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.SCX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.MNX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.PRG' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.FRX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.QPR'
      DEFI WINDOW avertiz FROM INT((SROWS()-11)/2), INT((SCOLS()-40)/2) TO INT((SROWS()-11)/2)+10, INT((SCOLS()-40)/2)+39 NOFLOAT NOCLOSE SHADOW TITLE 'ATENTIE !!!' NOMINIMIZE COLOR SCHEME 1
 ENDI
 IF WVISIBLE('avertiz')
      ACTI WINDOW SAME avertiz
 ELSE
      ACTI WINDOW NOSHOW avertiz
 ENDI
 @ 8, 12 GET M.ies DEFAULT 1 SIZE 1, 13, 1 PICTURE '@*HT \!\?\<Iesire'
 @ 6, 7 SAY tranzact.c_operat-INT(tranzact.c_operat/1000000)*1000000 SIZE 1, 6 COLOR SCHEME 10
 @ 6, 24 SAY INT(tranzact.c_operat/1000000) SIZE 1, 4 COLOR SCHEME 10
 @ 6, 30 SAY 'crt=' SIZE 1, 4, 0
 @ 6, 34 SAY tranzact.crt SIZE 1, 3 COLOR SCHEME 10
 @ 6, 1 SAY 'Oper.' SIZE 1, 5, 0
 @ 6, 15 SAY 'din' SIZE 1, 3, 0
 @ 6, 19 SAY 'anul' SIZE 1, 4, 0
 @ 1, 5 SAY 'Nu se poate sterge aceasta ' SIZE 1, 27, 0
 @ 2, 1 SAY 'operatiune deoarece s-a operat deja' SIZE 1, 35, 0
 @ 3, 1 SAY 'un material in operatiunea urmatoare' SIZE 1, 36, 0
 @ 3, 37 SAY '.' SIZE 1, 1, 0
 IF  .NOT. WVISIBLE('avertiz')
      ACTI WINDOW avertiz
 ENDI
 READ CYCLE
 RELE WINDOW avertiz
 IF M.talkstat='ON'
      SET TALK ON
 ENDI
 IF M.compstat='ON'
      SET COMPATIBLE TO DB4
 ENDI
*
