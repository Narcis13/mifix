 PRIV M.currarea, M.talkstat, M.compstat
 IF SET('TALK')='ON'
      SET TALK OFF
      M.talkstat = 'ON'
 ELSE
      M.talkstat = 'OFF'
 ENDI
 M.compstat = SET('COMPATIBLE')
 SET COMPATIBLE TO FOXPLUS
 IF  .NOT. WEXIST('avertiz') .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.PJX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.SCX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.MNX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.PRG' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.FRX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.QPR'
      DEFI WINDOW avertiz FROM INT((SROWS()-13)/2), INT((SCOLS()-40)/2) TO INT((SROWS()-13)/2)+12, INT((SCOLS()-40)/2)+39 NOFLOAT NOCLOSE SHADOW TITLE 'ATENTIE !!!' NOMINIMIZE COLOR SCHEME 1
 ENDI
 IF WVISIBLE('avertiz')
      ACTI WINDOW SAME avertiz
 ELSE
      ACTI WINDOW NOSHOW avertiz
 ENDI
 @ 10, 12 GET M.ies DEFAULT 1 SIZE 1, 13, 1 PICTURE '@*HT \!\?\<Iesire'
 @ 1, 4 SAY 'Nu se poate face o modificare pe' SIZE 1, 32, 0
 @ 3, 1 SAY 'modificari la acesta pe o operatiune' SIZE 1, 36, 0
 @ 4, 1 SAY 'care are data mai mare decat data' SIZE 1, 33, 0
 @ 5, 1 SAY 'operatiunii curente sau are numarul' SIZE 1, 35, 0
 @ 6, 1 SAY 'de operatiune mai mare.' SIZE 1, 23, 0
 @ 8, 7 SAY tranzact.c_operat-INT(tranzact.c_operat/1000000)*1000000 SIZE 1, 6 COLOR SCHEME 10
 @ 8, 24 SAY INT(tranzact.c_operat/1000000) SIZE 1, 4 COLOR SCHEME 10
 @ 8, 30 SAY 'crt=' SIZE 1, 4, 0
 @ 8, 34 SAY tranzact.crt SIZE 1, 3 COLOR SCHEME 10
 @ 8, 1 SAY 'Oper.' SIZE 1, 5, 0
 @ 8, 15 SAY 'din' SIZE 1, 3, 0
 @ 8, 19 SAY 'anul' SIZE 1, 4, 0
 @ 2, 1 SAY 'acest material deoarece s-au facut  ' SIZE 1, 36, 0
 IF  .NOT. WVISIBLE('avertiz')
      ACTI WINDOW avertiz
 ENDI
 READ CYCLE
 RELE WINDOW avertiz
 IF M.talkstat='ON'
      SET TALK ON
 ENDI
 IF M.compstat='ON'
      SET COMPATIBLE TO DB4
 ENDI
*
