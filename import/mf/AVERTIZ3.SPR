 PRIV M.currarea, M.talkstat, M.compstat
 IF SET('TALK')='ON'
      SET TALK OFF
      M.talkstat = 'ON'
 ELSE
      M.talkstat = 'OFF'
 ENDI
 M.compstat = SET('COMPATIBLE')
 SET COMPATIBLE TO FOXPLUS
 IF  .NOT. WEXIST('avertiz') .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.PJX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.SCX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.MNX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.PRG' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.FRX' .OR. UPPER(WTITLE('AVERTIZ'))=='AVERTIZ.QPR'
      DEFI WINDOW avertiz FROM INT((SROWS()-11)/2), INT((SCOLS()-40)/2) TO INT((SROWS()-11)/2)+10, INT((SCOLS()-40)/2)+39 NOFLOAT NOCLOSE SHADOW TITLE 'ATENTIE !!!' NOMINIMIZE COLOR SCHEME 1
 ENDI
 IF WVISIBLE('avertiz')
      ACTI WINDOW SAME avertiz
 ELSE
      ACTI WINDOW NOSHOW avertiz
 ENDI
 @ 8, 12 GET M.ies DEFAULT 1 SIZE 1, 13, 1 PICTURE '@*HT \!\?\<Iesire'
 @ 1, 3 SAY 'Ati operat deja acte cu ajutorul' SIZE 1, 32, 0
 @ 2, 1 SAY 'programului.' SIZE 1, 12, 0
 @ 3, 3 SAY 'In acest caz nu mai puteti' SIZE 1, 26, 0
 @ 4, 1 SAY 'introduce lista de inventariere.' SIZE 1, 32, 0
 @ 5, 3 SAY 'Daca doriti modificari la lista de' SIZE 1, 34, 0
 @ 6, 1 SAY 'inventariere operati NOTA EXPLICATIVA' SIZE 1, 37, 0
 IF  .NOT. WVISIBLE('avertiz')
      ACTI WINDOW avertiz
 ENDI
 READ CYCLE
 RELE WINDOW avertiz
 IF M.talkstat='ON'
      SET TALK ON
 ENDI
 IF M.compstat='ON'
      SET COMPATIBLE TO DB4
 ENDI
*
