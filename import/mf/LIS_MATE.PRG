 CLEA
 SET TALK OFF
 SET ECHO OFF
 DEFI WINDOW vizualiz FROM 0, 0 TO 24, 79 SYSTEM COLOR ,,,,BG/N,W+/B,,,B/W 
 CLOS ALL
 SELE 1
 USE GESTIUNI
 IF  .NOT. WEXIST('_rhr0ru13x')
      DEFI WINDOW _rhr0ru13x FROM INT((SROWS()-13)/2), INT((SCOLS()-35)/2) TO INT((SROWS()-13)/2)+12, INT((SCOLS()-35)/2)+34 NOFLOAT NOCLOSE SHADOW NOMINIMIZE COLOR SCHEME 1
 ENDI
 PUBL M.arma
 M.arma = 1
 SHOW GETS
 DEFI POPUP _rhr0ru1ur PROMPT FIELDS denumire MARK '' MARGIN SCROLL
 IF WVISIBLE('_rhr0ru13x')
      ACTI WINDOW SAME _rhr0ru13x
 ELSE
      ACTI WINDOW NOSHOW _rhr0ru13x
 ENDI
 @ 2,2 GET m.arma  PICTURE "@&T"  POPUP _rhr0ru1ur  SIZE 9,28  DEFAULT " "  COLOR SCHEME 2
 @ 0, 13 SAY 'GESTIUNEA' SIZE 1, 9, 0
 @ 1, 13 SAY '---------' SIZE 1, 9, 0
 IF  .NOT. WVISIBLE('_rhr0ru13x')
      ACTI WINDOW _rhr0ru13x
 ENDI
 READ CYCLE
 M.arma = gestiuni.cod
 RELE WINDOW _rhr0ru13x
 IF USED('GESTIUNI')
      SELE gestiuni
      USE
 ENDI
 CLOS ALL
 SELE 1
 USE NOUPDATE SOLDURI
 SET ORDER TO COD_DEN OF SOLDURI.CDX
 SET FILTER TO cod_ges=M.arma
 SELE 2
 USE NOUPDATE MATERIAL
 IF optiune=1
      SET ORDER TO NUME OF MATERIAL.CDX
 ENDI
 IF optiune=2
      SET ORDER TO COD OF MATERIAL.CDX
 ENDI
 IF optiune=3
      SET ORDER TO COD_M OF MATERIAL.CDX
 ENDI
 SET RELATION TO material.cod INTO solduri ADDITIVE
 SELE 1
 SET FILTER TO solduri.cod_ges=M.arma
 SELE 2
 SET FILTER TO  .NOT. EOF(1)
 GOTO TOP
 CLEA
 list = 'N'
 @ 3, 5 SAY 'SITUATIA SE LISTEAZA LA IMPRIMANTA       =    ' COLOR GR+/B,R/W  GET list SIZE 1, 1
 READ
 se_listeaz = .F.
 IF list='D' .OR. list='d'
      se_listeaz = .T.
 ENDI
 CLEA
 SET PROCEDURE TO librarie
 = set_print()
 SET PROCEDURE TO
 SELE 0
 USE RAPORT6.FRX
 REPL height WITH _PLENGTH
 USE
 SELE 2
 IF se_listeaz=.T.
      PRIN
      CLEA
      @ 5, 5 SAY 'ASTEPTATI PANA SE LISTEAZA LA IMPRIMANTA ' COLOR GR+/B,R/W 
      REPO FORMAT RAPORT6 TO PRINTER NOCONSOLE
      ENDP
 ELSE
      DEFI WINDOW vizualiz FROM 0, 0 TO 24, 79 SYSTEM COLOR ,,,,BG/N,W+/B,,,B/W 
      IF FILE('LIS_MATE.TXT')
           ERAS 'LIS_MATE.TXT'
      ENDI
      CLEA
      @ 5, 5 SAY 'ASTEPTATI PANA SE GENEREAZA RAPORTUL' COLOR GR+/B,R/W 
      SET PRINTER TO LIS_MATE.txt
      PRIN
      REPO FORMAT RAPORT6 TO PRINTER NOCONSOLE
      ENDP
      SET PRINTER TO
      MODI COMMAND 'LIS_MATE.TXT' NOEDIT WINDOW vizualiz
      RELE WINDOW vizualiz
 ENDI
 CLOS ALL
 CLEA
 CLEA MEMO
*
