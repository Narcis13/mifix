*
PROC _03i0sia0p
 HIDE MENU men_prg
 HIDE POPUP ALL
 HIDE WINDOW ALL
 CLEA
 CLOS ALL
 SELE 1
 USE CONTURI
 SELE 2
 USE TRANZACT
 SET ORDER TO CONT
 SELE 1
 LOCA ALL FOR titlu=.F.
 DO WHILE FOUND()
      SELE 2
      SEEK A.cod_cont
      IF  .NOT. FOUND()
           SELE 1
           DELE
      ENDI
      SELE 1
      CONT
 ENDD
 SELE 1
 PACK
 CLOS ALL
 SELE 1
 USE CONTURI
 SET FILTER TO titlu=.T.
 SELE 2
 USE CONTURI AGAIN ALIAS conturi_a
 SET FILTER TO titlu=.F.
 SELE 1
 GOTO TOP
 DO WHILE  .NOT. EOF()
      lung = LEN(ALLTRIM(A.cont))
      SELE 2
      LOCA FOR SUBSTR(cont, 1, lung)==ALLTRIM(A.cont)
      IF  .NOT. FOUND()
           SELE 1
           DELE
      ENDI
      SELE 1
      SKIP 1
 ENDD
 CLOS ALL
 USE CONTURI
 PACK
 CLOS ALL
 CLEA MEMO
 CLEA
 HIDE WINDOW ALL
 SHOW MENU men_prg
 CLEA
 DO titlu.prg
 RETU TO MASTER
*
PROC _03i0sia0q
 HIDE MENU men_prg
 HIDE POPUP ALL
 HIDE WINDOW ALL
 CLEA
