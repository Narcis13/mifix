 DO WHILE  .NOT. EOF()
      SELE 2
      GOTO TOP
      SEEK A.cod
      IF  .NOT. FOUND()
           SELE 1
           DELE
      ENDI
      SELE 1
      SKIP 1
 ENDD
 SELE 1
 PACK
 CLOS ALL
